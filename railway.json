{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks",
    "buildCommand": "pnpm install && pnpm --filter @earnify/db db:generate && pnpm build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @earnify/api start",
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 5
  }
}
